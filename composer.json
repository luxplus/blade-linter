{
    "name": "luxplus/blade-linter",
    "description": "Blade template linter with auto-fix — enforces Luxplus blank-line conventions between sibling elements",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "stillat/blade-parser": "^2.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Luxplus\\BladeLinter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luxplus\\BladeLinter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Luxplus\\BladeLinter\\BladeLinterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
